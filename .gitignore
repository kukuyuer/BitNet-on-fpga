# ==========================================
# 编译输出与构建目录
# ==========================================
build/
build_*/
bin/
bin_arm64/
lib/
*.o
*.arm.o
*.x86.o
*.so
*.so.*
*.a
*.dylib
*.dll
*.exe

# 允许预编译第三方底层依赖库
!third_party/lib/
!third_party/lib/**

# ==========================================
# 日志、临时与转储文件
# ==========================================
*.log
!tests/golden_baselines/**
!tests/golden_30tokens.log
*.jou
*.str
*.d
*.out
*.bak
*.orig
*.rej
*.swp
*~
.DS_Store
xsim.dir/
sim_run/
*.wdb

# ==========================================
# 大模型权重与缓存 (禁止入库)
# ==========================================
models/
*.gguf
*.bin
*.pt
*.safetensors
*.v37p

# ==========================================
# Python 缓存
# ==========================================
__pycache__/
*.pyc

# ==========================================
# IDE 配置
# ==========================================
.vscode/
.idea/
# ==========================================
# 取消部分文档和emu
# ==========================================
docs/*.md
docs/diagrams/
docs/modules/
docs/technical_reports/
platforms/x86_emulator/